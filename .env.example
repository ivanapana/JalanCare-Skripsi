# Start in local demo mode. Switch to firebase only after setup.
APP_MODE=demo
# Use firebase credentials only locally. Never share or commit this JSON.
FIREBASE_CREDENTIALS=secrets/firebase-service-account.json
FIREBASE_WEB_API_KEY=
# Empty = photos stay on this computer; set bucket to enable Cloud Storage (Blaze).
FIREBASE_STORAGE_BUCKET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Trial value; select the final threshold on validation data.
YOLO_CONFIDENCE=0.25
# Leave empty to generate a stable local secret in private/session.key.
SECRET_KEY=
# Set true on HTTPS deployment; leave false for localhost.
COOKIE_SECURE=false

# Reverse geocoding of photo GPS only. The photo is not sent to this service.
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_USER_AGENT=JalanCareSkripsi/2.1 (provincial road reporting research)

# Off by default: the experimental detector can mistake road texture for faces.
# Automatic face/plate privacy is required in revision 2.5.

# Optional licensed map tile provider; configure attribution per provider terms.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION='© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'

# Local demo seed passwords (used only on first revision-2.5 initialization).
DEMO_RESIDENT_PASSWORD=WargaDemo2026!
DEMO_STAFF_PASSWORD=PetugasDemo2026!
